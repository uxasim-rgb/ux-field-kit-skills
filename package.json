  },
  "scripts": {
    "test": "npm run validate",
    "validate": "bash scripts/validate.sh",
    "check:evals": "node scripts/check-evals.js",
    "new-skill": "bash scripts/new-skill.sh",
    "eval": "claude plugin eval . --trust-plugin --max-cost-usd 30 --no-publish",
    "eval:smoke": "claude plugin eval . --case usability-testing --runs 1 --ablation none",
    "eval:case": "claude plugin eval . --runs 1 --ablation none --case"
  }
